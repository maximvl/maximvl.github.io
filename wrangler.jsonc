{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eldritch-implicits",
  "compatibility_date": "2026-11-25",
  // Build the Vite bundle before the assets are uploaded.
  "build": {
    "command": "pnpm build"
  },
  // Only the compiled output is served - never the raw source tree.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
